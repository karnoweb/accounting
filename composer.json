{
    "name": "karnoweb/laravel-accounting",
    "description": "Double-entry accounting package for Laravel with automatic document recording.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "accounting",
        "double-entry",
        "documents",
        "fiscal-year"
    ],
    "authors": [
        {
            "name": "Karnoweb",
            "email": "info@karnoweb.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Karnoweb\\Accounting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karnoweb\\Accounting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karnoweb\\Accounting\\AccountingServiceProvider"
            ],
            "aliases": {
                "Accounting": "Karnoweb\\Accounting\\Facades\\Accounting"
            }
        }
    },
    "version": "1.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true
}
